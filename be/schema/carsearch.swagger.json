  "paths": {
    "/carsearch.v1.CarSearchService/Get": {
      "post": {
        "summary": "Get возвращает появление номера по идентификатору.",
        "operationId": "CarSearchService_Get",
        "responses": {
          "200": {
            "description": "A successful response.",
