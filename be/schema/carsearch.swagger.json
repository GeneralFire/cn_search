{
  "swagger": "2.0",
  "info": {
    "title": "carsearch/carsearch.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "CarSearchService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/carsearch.CarSearchService/Clarify": {
      "post": {
        "summary": "Clarify — уточнение номера к фиксации («на самом деле номер такой»). Номер нормализуется\n(пробелы, регистр; для RU — латинские двойники → кириллица, «0» в буквенных позициях → «О»)\nи проверяется по формату plate_type; ошибка формата или совпадение с текущим номером\nфиксации — INVALID_ARGUMENT с текстом для пользователя. Создаётся «не принят»; когда\n3 уточнения фиксации совпали (без учёта похожих символов), все они становятся «принят».",
        "operationId": "CarSearchService_Clarify",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchClarifyResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchClarifyRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/Complain": {
      "post": {
        "summary": "Complain — жалоба на фото фиксации (кнопка «Пожаловаться»). Создаётся со статусом «новая».",
        "operationId": "CarSearchService_Complain",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchComplaint"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchComplainRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/Get": {
      "post": {
        "summary": "Get по идентификатору фиксации возвращает все фиксации того же номера — от новых к старым.",
        "operationId": "CarSearchService_Get",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchGetResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchGetRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/HideSighting": {
      "post": {
        "summary": "HideSighting — скрыть фиксацию (hidden = true) или вернуть её. Скрытые фиксации не попадают\nв Search/Get/SeeAlso обычных пользователей; админу отдаются с hidden = true. Нужен admin-token.",
        "operationId": "CarSearchService_HideSighting",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchPlateSighting"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchHideSightingRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/ListClarifications": {
      "post": {
        "summary": "ListClarifications — уточнения для админ-панели, от новых к старым, постранично, вместе с фиксацией.\nНужен заголовок admin-token.",
        "operationId": "CarSearchService_ListClarifications",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchListClarificationsResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchListClarificationsRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/ListComplaints": {
      "post": {
        "summary": "ListComplaints — жалобы для админ-панели, от новых к старым, постранично, вместе с фиксацией.\nНужен заголовок admin-token (= ADMIN_TOKEN бэка), иначе PERMISSION_DENIED.",
        "operationId": "CarSearchService_ListComplaints",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchListComplaintsResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchListComplaintsRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/Me": {
      "post": {
        "summary": "Me — кто спрашивает: is_admin, если заголовок admin-token верный. Без токена или с неверным —\nis_admin = false (не ошибка): фронт так решает, включать ли админ-режим.",
        "operationId": "CarSearchService_Me",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchMeResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchMeRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/ResolveComplaint": {
      "post": {
        "summary": "ResolveComplaint — отметить жалобу решённой. Нужен заголовок admin-token.",
        "operationId": "CarSearchService_ResolveComplaint",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchComplaint"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchResolveComplaintRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/Search": {
      "post": {
        "summary": "Search ищет номера: по самому номеру и по уточнениям (clarifications) к его фиксациям.\nОдин номер — одна строка (последняя подходящая фиксация). От новых к старым, постранично.",
        "operationId": "CarSearchService_Search",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchSearchResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchSearchRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/SeeAlso": {
      "post": {
        "summary": "SeeAlso — свежие фиксации других номеров (блок внизу страницы номера): один номер — одна\nкарточка, номер открытой фиксации исключён. Не более 21.",
        "operationId": "CarSearchService_SeeAlso",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchSeeAlsoResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchSeeAlsoRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/SetClarificationStatus": {
      "post": {
        "summary": "SetClarificationStatus — принять или отклонить уточнение вручную. Нужен заголовок admin-token.",
        "operationId": "CarSearchService_SetClarificationStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchClarification"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchSetClarificationStatusRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    }
  },
  "definitions": {
    "carsearchClarification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sightingId": {
          "type": "string",
          "description": "uuid фиксации, к которой уточнение."
        },
        "plate": {
          "type": "string",
          "description": "Предложенный номер в нормализованном виде: \"А123ВС 77\"."
        },
        "status": {
          "$ref": "#/definitions/carsearchClarificationStatus",
          "description": "Актуальный статус: ACCEPTED, когда совпали 3 уточнения фиксации."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "plateType": {
          "$ref": "#/definitions/carsearchPlateType"
        },
        "plateRegion": {
          "type": "string"
        },
        "sighting": {
          "$ref": "#/definitions/carsearchPlateSighting",
          "description": "Фиксация (номер, адрес, фото) — только в ListClarifications."
        }
      },
      "description": "Clarification — уточнение номера к фиксации."
    },
    "carsearchClarificationStatus": {
      "type": "string",
      "enum": [
        "CLARIFICATION_STATUS_UNSPECIFIED",
        "CLARIFICATION_STATUS_NOT_ACCEPTED",
        "CLARIFICATION_STATUS_ACCEPTED"
      ],
      "default": "CLARIFICATION_STATUS_UNSPECIFIED",
      "description": "Статус уточнения."
    },
    "carsearchClarifyRequest": {
      "type": "object",
      "properties": {
        "sightingId": {
          "type": "string",
          "description": "uuid фиксации."
        },
        "plate": {
          "type": "string",
          "description": "Номер, 1..32 символа. RU: А123ВС 77 / А123ВС 777 (пробел перед регионом можно не ставить);\nEU/US: 2..12 символов — латиница, цифры, пробел, дефис; DEFAULT — формат не проверяется."
        },
        "plateType": {
          "$ref": "#/definitions/carsearchPlateType",
          "description": "Формат номера; DEFAULT — другой/неизвестен."
        },
        "plateRegion": {
          "type": "string",
          "description": "Страна (ЕС: \"D\") или штат (США: \"CA\"), до 3 латинских букв; для RU/DEFAULT не нужен."
        }
      }
    },
    "carsearchClarifyResponse": {
      "type": "object",
      "properties": {
        "clarification": {
          "$ref": "#/definitions/carsearchClarification"
        }
      }
    },
    "carsearchComplainRequest": {
      "type": "object",
      "properties": {
        "sightingId": {
          "type": "string",
          "description": "uuid фиксации."
        },
        "reason": {
          "$ref": "#/definitions/carsearchComplaintReason",
          "description": "Причина, обязательна."
        },
        "comment": {
          "type": "string",
          "description": "Комментарий, до 500 символов; можно пусто."
        }
      }
    },
    "carsearchComplaint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sightingId": {
          "type": "string",
          "description": "uuid фиксации, на фото которой жалоба."
        },
        "reason": {
          "$ref": "#/definitions/carsearchComplaintReason"
        },
        "comment": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/carsearchComplaintStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "sighting": {
          "$ref": "#/definitions/carsearchPlateSighting",
          "description": "Фиксация (номер, адрес, фото, время) — только в ListComplaints."
        }
      },
      "description": "Complaint — жалоба на фото фиксации."
    },
    "carsearchComplaintReason": {
      "type": "string",
      "enum": [
        "COMPLAINT_REASON_UNSPECIFIED",
        "COMPLAINT_REASON_WRONG_PLATE",
        "COMPLAINT_REASON_BAD_PHOTO",
        "COMPLAINT_REASON_PERSONAL_DATA",
        "COMPLAINT_REASON_OTHER"
      ],
      "default": "COMPLAINT_REASON_UNSPECIFIED",
      "description": "Причина жалобы на фото."
    },
    "carsearchComplaintStatus": {
      "type": "string",
      "enum": [
        "COMPLAINT_STATUS_UNSPECIFIED",
        "COMPLAINT_STATUS_NEW",
        "COMPLAINT_STATUS_RESOLVED"
      ],
      "default": "COMPLAINT_STATUS_UNSPECIFIED",
      "description": "Статус жалобы."
    },
    "carsearchGetRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid любой фиксации номера."
        }
      }
    },
    "carsearchGetResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchPlateSighting"
          },
          "description": "Все фиксации номера, от новых к старым; первая по id всегда среди них."
        }
      }
    },
    "carsearchHideSightingRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid фиксации."
        },
        "hidden": {
          "type": "boolean",
          "description": "true — скрыть, false — показать снова."
        }
      }
    },
    "carsearchListClarificationsRequest": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/carsearchClarificationStatus",
          "description": "Фильтр по статусу; UNSPECIFIED — все."
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "Сколько пропустить («Загрузить ещё»)."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "Размер страницы, 1..100; 0 — по умолчанию (30)."
        },
        "sightingId": {
          "type": "string",
          "description": "Только уточнения к этой фиксации (uuid); пусто — все."
        }
      }
    },
    "carsearchListClarificationsResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchClarification"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "Всего уточнений по фильтру."
        },
        "nextOffset": {
          "type": "integer",
          "format": "int32",
          "description": "Смещение следующей страницы; не задано — дальше ничего нет."
        }
      }
    },
    "carsearchListComplaintsRequest": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "Сколько жалоб пропустить («Загрузить ещё»)."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "Размер страницы, 1..100; 0 — по умолчанию (30)."
        },
        "status": {
          "$ref": "#/definitions/carsearchComplaintStatus",
          "description": "Фильтр по статусу; UNSPECIFIED — все."
        },
        "sightingId": {
          "type": "string",
          "description": "Только жалобы на эту фиксацию (uuid); пусто — все."
        }
      }
    },
    "carsearchListComplaintsResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchComplaint"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "Всего жалоб по фильтру."
        },
        "nextOffset": {
          "type": "integer",
          "format": "int32",
          "description": "Смещение следующей страницы; не задано — дальше ничего нет."
        }
      }
    },
    "carsearchMeRequest": {
      "type": "object"
    },
    "carsearchMeResponse": {
      "type": "object",
      "properties": {
        "isAdmin": {
          "type": "boolean",
          "description": "Заголовок admin-token верный: можно включать админ-режим."
        }
      }
    },
    "carsearchPlateSighting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid фиксации."
        },
        "photoUrl": {
          "type": "string",
          "description": "URL полного фото (S3)."
        },
        "address": {
          "type": "string"
        },
        "plate": {
          "type": "string",
          "description": "Госномер кириллицей: \"А123ВС 777\"."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Когда номер зафиксирован."
        },
        "thumbUrl": {
          "type": "string",
          "description": "URL миниатюры (S3) — для списков; полное фото — photo_url."
        },
        "plateType": {
          "$ref": "#/definitions/carsearchPlateType",
          "description": "Формат номера (plates.meta.type); не задан — неизвестен."
        },
        "plateRegion": {
          "type": "string",
          "description": "Страна (ЕС: \"D\") или штат (США: \"CA\") для формата номера."
        },
        "addressLocale": {
          "type": "string",
          "title": "Язык, на котором записан адрес: \"ru\", \"en\", \"de\", …"
        },
        "lat": {
          "type": "number",
          "format": "double",
          "description": "Координаты места фиксации (WGS 84, градусы); не заданы — точка неизвестна."
        },
        "lon": {
          "type": "number",
          "format": "double"
        },
        "hidden": {
          "type": "boolean",
          "description": "Фиксация скрыта админом; приходит только админу (обычным пользователям скрытые не отдаются)."
        }
      },
      "description": "PlateSighting — фиксация номера: где и когда замечена машина."
    },
    "carsearchPlateType": {
      "type": "string",
      "enum": [
        "PLATE_TYPE_DEFAULT",
        "PLATE_TYPE_RU",
        "PLATE_TYPE_EU",
        "PLATE_TYPE_US",
        "PLATE_TYPE_UA",
        "PLATE_TYPE_CN"
      ],
      "default": "PLATE_TYPE_DEFAULT",
      "description": "Формат номерного знака — от него зависит, как его рисовать."
    },
    "carsearchResolveComplaintRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid жалобы."
        }
      }
    },
    "carsearchSearchRequest": {
      "type": "object",
      "properties": {
        "plate": {
          "type": "string",
          "description": "Поисковая строка, как есть передаётся в plainto_tsquery('simple', plate) и сопоставляется\nс to_tsvector('simple', plate): каждое слово должно совпасть со словом номера —\nсерией \"А123ВС\" или регионом \"777\". Пусто — все записи."
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "Сколько записей пропустить (для бесконечной прокрутки)."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "Размер страницы, 1..100; 0 — по умолчанию (35)."
        },
        "market": {
          "type": "string",
          "description": "«Рынок» номеров (главная: блок по языку интерфейса и вкладки стран):\n\"ru\" — российские, \"ua\" — украинские, \"de\" — ЕС с регионом D, \"us\" — США, \"cn\" — китайские,\n\"other\" — всё, что не попало ни в один рынок (формат неизвестен или другая страна).\nПусто — без фильтра."
        }
      }
    },
    "carsearchSearchResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchPlateSighting"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "Всего найдено номеров по запросу."
        },
        "nextOffset": {
          "type": "integer",
          "format": "int32",
          "description": "Смещение следующей страницы; не задано — дальше ничего нет."
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchPlateSighting"
          },
          "description": "«Возможно, вы искали»: только при total = 0 и непустом запросе — до 5 номеров, ближайших\nк запросу по расстоянию правки (levenshtein) между ключами plate_search_key без пробелов,\nне дальше 2 правок; по одной (последней) фиксации на номер, ближайшие первыми."
        }
      }
    },
    "carsearchSeeAlsoRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid открытой фиксации: её номер в выдачу не попадает. Пусто — без исключения."
