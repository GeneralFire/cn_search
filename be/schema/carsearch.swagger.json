{
  "swagger": "2.0",
  "info": {
    "title": "carsearch/carsearch.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "CarSearchService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/carsearch.CarSearchService/Clarify": {
      "post": {
        "summary": "Clarify — уточнение номера к фиксации («на самом деле номер такой»). Номер нормализуется\n(пробелы, регистр; для RU — латинские двойники → кириллица, «0» в буквенных позициях → «О»)\nи проверяется по формату plate_type; ошибка формата или совпадение с текущим номером\nфиксации — INVALID_ARGUMENT с текстом для пользователя. Создаётся «не принят»; когда\n3 уточнения фиксации совпали (без учёта похожих символов), все они становятся «принят».",
        "operationId": "CarSearchService_Clarify",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchClarifyResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchClarifyRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/Get": {
      "post": {
        "summary": "Get по идентификатору фиксации возвращает все фиксации того же номера — от новых к старым.",
        "operationId": "CarSearchService_Get",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchGetResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchGetRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/Search": {
      "post": {
        "summary": "Search ищет номера: по самому номеру и по уточнениям (clarifications) к его фиксациям.\nОдин номер — одна строка (последняя подходящая фиксация). От новых к старым, постранично.",
        "operationId": "CarSearchService_Search",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchSearchResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchSearchRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    },
    "/carsearch.CarSearchService/SeeAlso": {
      "post": {
        "summary": "SeeAlso — свежие фиксации других номеров (блок внизу страницы номера): один номер — одна\nкарточка, номер открытой фиксации исключён. Не более 21.",
        "operationId": "CarSearchService_SeeAlso",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/carsearchSeeAlsoResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/carsearchSeeAlsoRequest"
            }
          }
        ],
        "tags": [
          "CarSearchService"
        ]
      }
    }
  },
  "definitions": {
    "carsearchClarification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sightingId": {
          "type": "string",
          "description": "uuid фиксации, к которой уточнение."
        },
        "plate": {
          "type": "string",
          "description": "Предложенный номер в нормализованном виде: \"А123ВС 77\"."
        },
        "status": {
          "$ref": "#/definitions/carsearchClarificationStatus",
          "description": "Актуальный статус: ACCEPTED, когда совпали 3 уточнения фиксации."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "plateType": {
          "$ref": "#/definitions/carsearchPlateType"
        },
        "plateRegion": {
          "type": "string"
        }
      },
      "description": "Clarification — уточнение номера к фиксации."
    },
    "carsearchClarificationStatus": {
      "type": "string",
      "enum": [
        "CLARIFICATION_STATUS_UNSPECIFIED",
        "CLARIFICATION_STATUS_NOT_ACCEPTED",
        "CLARIFICATION_STATUS_ACCEPTED"
      ],
      "default": "CLARIFICATION_STATUS_UNSPECIFIED",
      "description": "Статус уточнения."
    },
    "carsearchClarifyRequest": {
      "type": "object",
      "properties": {
        "sightingId": {
          "type": "string",
          "description": "uuid фиксации."
        },
        "plate": {
          "type": "string",
          "description": "Номер, 1..32 символа. RU: А123ВС 77 / А123ВС 777 (пробел перед регионом можно не ставить);\nEU/US: 2..12 символов — латиница, цифры, пробел, дефис; DEFAULT — формат не проверяется."
        },
        "plateType": {
          "$ref": "#/definitions/carsearchPlateType",
          "description": "Формат номера; DEFAULT — другой/неизвестен."
        },
        "plateRegion": {
          "type": "string",
          "description": "Страна (ЕС: \"D\") или штат (США: \"CA\"), до 3 латинских букв; для RU/DEFAULT не нужен."
        }
      }
    },
    "carsearchClarifyResponse": {
      "type": "object",
      "properties": {
        "clarification": {
          "$ref": "#/definitions/carsearchClarification"
        }
      }
    },
    "carsearchGetRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid любой фиксации номера."
        }
      }
    },
    "carsearchGetResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchPlateSighting"
          },
          "description": "Все фиксации номера, от новых к старым; первая по id всегда среди них."
        }
      }
    },
    "carsearchPlateSighting": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid фиксации."
        },
        "photoUrl": {
          "type": "string",
          "description": "URL полного фото (S3)."
        },
        "address": {
          "type": "string"
        },
        "plate": {
          "type": "string",
          "description": "Госномер кириллицей: \"А123ВС 777\"."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Когда номер зафиксирован."
        },
        "thumbUrl": {
          "type": "string",
          "description": "URL миниатюры (S3) — для списков; полное фото — photo_url."
        },
        "plateType": {
          "$ref": "#/definitions/carsearchPlateType",
          "description": "Формат номера (plates.meta.type); не задан — неизвестен."
        },
        "plateRegion": {
          "type": "string",
          "description": "Страна (ЕС: \"D\") или штат (США: \"CA\") для формата номера."
        },
        "addressLocale": {
          "type": "string",
          "title": "Язык, на котором записан адрес: \"ru\", \"en\", \"de\", …"
        },
        "lat": {
          "type": "number",
          "format": "double",
          "description": "Координаты места фиксации (WGS 84, градусы); не заданы — точка неизвестна."
        },
        "lon": {
          "type": "number",
          "format": "double"
        }
      },
      "description": "PlateSighting — фиксация номера: где и когда замечена машина."
    },
    "carsearchPlateType": {
      "type": "string",
      "enum": [
        "PLATE_TYPE_DEFAULT",
        "PLATE_TYPE_RU",
        "PLATE_TYPE_EU",
        "PLATE_TYPE_US",
        "PLATE_TYPE_UA",
        "PLATE_TYPE_CN"
      ],
      "default": "PLATE_TYPE_DEFAULT",
      "description": "Формат номерного знака — от него зависит, как его рисовать."
    },
    "carsearchSearchRequest": {
      "type": "object",
      "properties": {
        "plate": {
          "type": "string",
          "description": "Поисковая строка, как есть передаётся в plainto_tsquery('simple', plate) и сопоставляется\nс to_tsvector('simple', plate): каждое слово должно совпасть со словом номера —\nсерией \"А123ВС\" или регионом \"777\". Пусто — все записи."
        },
        "offset": {
          "type": "integer",
          "format": "int32",
          "description": "Сколько записей пропустить (для бесконечной прокрутки)."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "Размер страницы, 1..100; 0 — по умолчанию (35)."
        },
        "market": {
          "type": "string",
          "description": "«Рынок» номеров (главная: блок по языку интерфейса и вкладки стран):\n\"ru\" — российские, \"ua\" — украинские, \"de\" — ЕС с регионом D, \"us\" — США, \"cn\" — китайские,\n\"other\" — всё, что не попало ни в один рынок (формат неизвестен или другая страна).\nПусто — без фильтра."
        }
      }
    },
    "carsearchSearchResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchPlateSighting"
          }
        },
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "Всего найдено номеров по запросу."
        },
        "nextOffset": {
          "type": "integer",
          "format": "int32",
          "description": "Смещение следующей страницы; не задано — дальше ничего нет."
        }
      }
    },
    "carsearchSeeAlsoRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid открытой фиксации: её номер в выдачу не попадает. Пусто — без исключения."
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "Сколько карточек, 1..21; 0 — 21."
        }
      }
    },
    "carsearchSeeAlsoResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carsearchPlateSighting"
          }
        }
      }
    }
  }
}
